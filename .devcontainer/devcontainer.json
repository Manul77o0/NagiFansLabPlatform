{
  "name": "Python (uv)",
  "image": "ghcr.io/astral-sh/uv:debian",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    }
  },
  "forwardPorts": [8000, 5173],
  "mounts": [
    {
      "source": "uv",
      "target": "/home/vscode/.cache/uv",
      "type": "volume"
    },
    {
      "source": "venv-${devcontainerId}",
      "target": "${containerWorkspaceFolder}/.venv",
      "type": "volume"
    },
    {
      "source": "${localEnv:HOME}/.ssh/id_ed25519_gitsign",
      "target": "/home/vscode/.ssh/id_ed25519_gitsign",
      "type": "bind"
    },
    {
      "source": "${localEnv:HOME}/.ssh/id_ed25519_gitsign.pub",
      "target": "/home/vscode/.ssh/id_ed25519_gitsign.pub",
      "type": "bind"
    }
  ],
  "containerEnv": {
    "UV_LINK_MODE": "copy"
  },
  "onCreateCommand": "sudo chown -R vscode:vscode /home/vscode/.cache/uv .venv",
  "postCreateCommand": "git config --global gpg.format ssh && git config --global user.signingkey /home/vscode/.ssh/id_ed25519_gitsign.pub && git config --global commit.gpgsign true && cd frontend && npm install && sudo apt-get update && sudo apt-get install -y sqlite3",
    "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.vscode-python-envs",
        "ms-azuretools.vscode-containers",
        "tamasfe.even-better-toml",
        "KevinRose.vsc-python-indent",
        "charliermarsh.ruff",
        "ms-python.vscode-pylance",
        "Vue.volar"
      ]
    }
  },
  "remoteUser": "vscode"
}